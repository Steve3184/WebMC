root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.{java,gradle,groovy,kt,kts}]
indent_style = space
indent_size = 4

[*.{js,cjs,mjs,ts,tsx,css,scss,html,json,yml,yaml}]
indent_style = space
indent_size = 2

[*.{sh,ps1,bat}]
indent_style = space
indent_size = 4
