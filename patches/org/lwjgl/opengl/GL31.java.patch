+package org.lwjgl.opengl;
+
+import top.steve3184.webmc.teavm.gl.GLBackendHolder;
+
+/** Stub of {@code org.lwjgl.opengl.GL31}. UBO, instanced rendering, primitive restart. */
+public final class GL31 {
+    public static final int GL_UNIFORM_BUFFER         = 0x8A11;
+    public static final int GL_UNIFORM_BUFFER_BINDING = 0x8A28;
+    public static final int GL_UNIFORM_BUFFER_START   = 0x8A29;
+    public static final int GL_UNIFORM_BUFFER_SIZE    = 0x8A2A;
+
+    public static final int GL_TEXTURE_BUFFER         = 0x8C2A; // unsupported in WebGL2
+    public static final int GL_PRIMITIVE_RESTART      = 0x8F9D;
+    public static final int GL_PRIMITIVE_RESTART_INDEX = 0x8F9E;
+
+    public static void glDrawArraysInstanced(int mode, int first, int count, int primCount) {
+        GLBackendHolder.current().drawArraysInstanced(mode, first, count, primCount);
+    }
+    public static void glDrawElementsInstanced(int mode, int count, int type, long offset, int primCount) {
+        GLBackendHolder.current().drawElementsInstanced(mode, count, type, offset, primCount);
+    }
+    public static int  glGetUniformBlockIndex(int p, CharSequence name)  { return GLBackendHolder.current().getUniformBlockIndex(p, name); }
+    public static void glUniformBlockBinding(int p, int idx, int bind)   { GLBackendHolder.current().uniformBlockBinding(p, idx, bind); }
+    public static String glGetActiveUniformBlockName(int program, int index) { return ""; }
+    public static int  glGetActiveUniformBlocki(int program, int index, int pname) { return 0; }
+    public static void glBindBufferRange(int t, int idx, int buf, long off, long size) {
+        GLBackendHolder.current().bindBufferRange(t, idx, buf, off, size);
+    }
+    public static void glCopyBufferSubData(int readTarget, int writeTarget, long readOffset, long writeOffset, long size) { /* no-op */ }
+    public static void glTexBuffer(int target, int internalformat, int buffer) { /* WebGL2 lacks texture buffer; no-op (caller will get blank texel reads) */ }
+
+    private GL31() {}
+}
