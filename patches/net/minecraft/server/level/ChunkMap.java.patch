+    private static void ensureWebFallbackTerrain(ChunkAccess chunk, ChunkStatus target) {
+        if (!BuildFlags.WEB_RUNTIME || target.isBefore(ChunkStatus.NOISE)) {
+            return;
+        }
+
+        int minY = chunk.getMinY();
+        if (chunk.isOutsideBuildHeight(minY + 3)) {
+            return;
+        }
+
+        BlockState bedrock = Blocks.BEDROCK.defaultBlockState();
+        BlockState dirt = Blocks.DIRT.defaultBlockState();
+        BlockState grass = Blocks.GRASS_BLOCK.defaultBlockState();
+        BlockPos.MutableBlockPos pos = new BlockPos.MutableBlockPos();
+        ChunkPos chunkPos = chunk.getPos();
+        Heightmap oceanFloor = chunk.getOrCreateHeightmapUnprimed(Heightmap.Types.OCEAN_FLOOR_WG);
+        Heightmap worldSurface = chunk.getOrCreateHeightmapUnprimed(Heightmap.Types.WORLD_SURFACE_WG);
+        Heightmap oceanFloorFinal = chunk.getOrCreateHeightmapUnprimed(Heightmap.Types.OCEAN_FLOOR);
+        Heightmap worldSurfaceFinal = chunk.getOrCreateHeightmapUnprimed(Heightmap.Types.WORLD_SURFACE);
+        Heightmap motionBlocking = chunk.getOrCreateHeightmapUnprimed(Heightmap.Types.MOTION_BLOCKING);
+        Heightmap motionBlockingNoLeaves = chunk.getOrCreateHeightmapUnprimed(Heightmap.Types.MOTION_BLOCKING_NO_LEAVES);
+
+        int placed = 0;
+        for (int x = 0; x < 16; x++) {
+            for (int z = 0; z < 16; z++) {
+                placed += setFallbackBlock(chunk, pos, chunkPos, x, minY, z, bedrock, oceanFloor, worldSurface, oceanFloorFinal, worldSurfaceFinal, motionBlocking, motionBlockingNoLeaves);
+                placed += setFallbackBlock(chunk, pos, chunkPos, x, minY + 1, z, dirt, oceanFloor, worldSurface, oceanFloorFinal, worldSurfaceFinal, motionBlocking, motionBlockingNoLeaves);
+                placed += setFallbackBlock(chunk, pos, chunkPos, x, minY + 2, z, dirt, oceanFloor, worldSurface, oceanFloorFinal, worldSurfaceFinal, motionBlocking, motionBlockingNoLeaves);
+                placed += setFallbackBlock(chunk, pos, chunkPos, x, minY + 3, z, grass, oceanFloor, worldSurface, oceanFloorFinal, worldSurfaceFinal, motionBlocking, motionBlockingNoLeaves);
+            }
+        }
+
+        if (chunk instanceof ProtoChunk protoChunk) {
+            protoChunk.setPersistedStatus(target);
+        } else if (chunk instanceof ImposterProtoChunk imposterProtoChunk) {
+            imposterProtoChunk.setPersistedStatus(target);
+        }
+
+        System.err.println(
+            "[mc-web/chunkgen] fallbackTerrain chunk="
+                + chunkPos.x
+                + ","
+                + chunkPos.z
+                + " target="
+                + target
+                + " minY="
+                + minY
+                + " blocks="
+                + placed
+        );
+    }
+
+    private static int setFallbackBlock(
+        ChunkAccess chunk,
+        BlockPos.MutableBlockPos pos,
+        ChunkPos chunkPos,
+        int x,
+        int y,
+        int z,
+        BlockState state,
+        Heightmap... heightmaps
+    ) {
+        pos.set(chunkPos.getBlockX(x), y, chunkPos.getBlockZ(z));
+        chunk.setBlockState(pos, state);
+        for (Heightmap heightmap : heightmaps) {
+            heightmap.update(x, y, z, state);
+        }
+        return 1;
+    }
