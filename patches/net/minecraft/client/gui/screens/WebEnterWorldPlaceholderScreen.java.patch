+package net.minecraft.client.gui.screens;
+
+import javax.annotation.Nullable;
+import net.minecraft.client.gui.GuiGraphics;
+import net.minecraft.client.gui.components.Button;
+import net.minecraft.network.chat.CommonComponents;
+import net.minecraft.network.chat.Component;
+import net.minecraftforge.api.distmarker.Dist;
+import net.minecraftforge.api.distmarker.OnlyIn;
+
+@OnlyIn(Dist.CLIENT)
+public class WebEnterWorldPlaceholderScreen extends Screen {
+    @Nullable
+    private final Screen returnScreen;
+    private final String worldName;
+    private final Component detail;
+
+    public WebEnterWorldPlaceholderScreen(@Nullable Screen p_410001_, String p_410002_) {
+        super(Component.literal("Entering Web World"));
+        this.returnScreen = p_410001_;
+        this.worldName = p_410002_;
+        this.detail = Component.literal("World bootstrap not wired yet: " + p_410002_);
+    }
+
+    @Override
+    protected void init() {
+        System.out.println("[mc-web/createworld] placeholder screen init");
+        this.addRenderableWidget(
+            Button.builder(Component.literal("Continue (experimental)"), p_410011_ -> this.minecraft.startWebExperimentalWorld(this.worldName, this))
+                .bounds(this.width / 2 - 100, this.height - 52, 200, 20)
+                .build()
+        );
+        this.addRenderableWidget(
+            Button.builder(CommonComponents.GUI_BACK, p_410010_ -> this.minecraft.setScreen(this.returnScreen))
+                .bounds(this.width / 2 - 100, this.height - 28, 200, 20)
+                .build()
+        );
+    }
+
+    @Override
+    public void render(GuiGraphics p_410003_, int p_410004_, int p_410005_, float p_410006_) {
+        super.render(p_410003_, p_410004_, p_410005_, p_410006_);
+        p_410003_.drawCenteredString(this.font, this.title, this.width / 2, this.height / 2 - 30, -1);
+        p_410003_.drawCenteredString(this.font, this.detail, this.width / 2, this.height / 2 - 8, -1);
+    }
+
+    @Override
+    public boolean shouldCloseOnEsc() {
+        return true;
+    }
+}
