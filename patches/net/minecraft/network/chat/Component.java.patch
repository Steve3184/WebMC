+    final class WebLiteralContents implements ComponentContents {
+        private static final ComponentContents.Type<WebLiteralContents> TYPE = new ComponentContents.Type<>((MapCodec<WebLiteralContents>)null, "web_literal");
+        private static final WebLiteralContents EMPTY = new WebLiteralContents("");
+        private final String text;
+
+        private WebLiteralContents(String text) {
+            this.text = text;
+        }
+
+        static WebLiteralContents create(String text) {
+            return text.isEmpty() ? EMPTY : new WebLiteralContents(text);
+        }
+
+        @Override
+        public <T> Optional<T> visit(FormattedText.ContentConsumer<T> consumer) {
+            return consumer.accept(this.text);
+        }
+
+        @Override
+        public <T> Optional<T> visit(FormattedText.StyledContentConsumer<T> consumer, Style style) {
+            return consumer.accept(style, this.text);
+        }
+
+        @Override
+        public ComponentContents.Type<?> type() {
+            return TYPE;
+        }
+    }
