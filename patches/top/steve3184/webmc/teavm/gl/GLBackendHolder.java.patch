+++ b/top\steve3184\webmc\teavm\gl\GLBackendHolder.java
@@ -0,0 +1,27 @@
+package top.steve3184.webmc.teavm.gl;
+
+/**
+ * Service-locator for the WebGL2 backend implementation. Real impl lives in
+ * addons/teavm-runtime (top.steve3184.webmc.teavm.runtime.WebGLBackend) and registers
+ * itself at startup via {@link #install(GLBackend)}.
+ *
+ * Why a holder class instead of a static field on the impl: the
+ * {@code lwjgl-stubs} module must not depend on {@code teavm-runtime}, since
+ * both end up in the same source tree but are conceptually layered. The stubs
+ * call {@link #current()} and the runtime sets the impl during boot.
+ */
+public final class GLBackendHolder {
+    private static GLBackend INSTANCE;
+    private GLBackendHolder() {}
+
+    public static void install(GLBackend backend) {
+        if (INSTANCE != null) throw new IllegalStateException("GLBackend already installed");
+        INSTANCE = backend;
+    }
+
+    public static GLBackend current() {
+        if (INSTANCE == null) throw new IllegalStateException(
+            "GLBackend not installed. Did teavm-runtime bootstrap?");
+        return INSTANCE;
+    }
+}
