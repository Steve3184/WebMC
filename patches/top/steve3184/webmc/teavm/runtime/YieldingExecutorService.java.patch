+package top.steve3184.webmc.teavm.runtime;
+
+import java.util.ArrayList;
+import java.util.ArrayDeque;
+import java.util.Collections;
+import java.util.Deque;
+import java.util.List;
+import java.util.Collection;
+import java.util.concurrent.Callable;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Future;
+import java.util.concurrent.FutureTask;
+import java.util.concurrent.TimeUnit;
+
+import org.teavm.jso.browser.Window;
+
+/**
+ * Cooperative time-sliced executor.
+ *
+ * <p>Background: in the browser, nested {@code setTimeout(…, 0)} clamps to
+ * ≥4ms per call once you're past a few levels deep. MC's resource reload
+ * dispatches thousands of {@code CompletableFuture.supplyAsync} stages —
+ * one setTimeout per stage costs ~4ms × N, which on N≈3000 is tens of
+ * seconds of mostly-idle waiting (the page looks frozen).</p>
+ *
+ * <p>Strategy: keep an explicit queue. {@code execute} appends and, if no
+ * pump is currently scheduled, kicks off a {@code setTimeout(…, 0)}. The
+ * pump drains as many queued runnables as fit in {@code SLICE_MS}, then
+ * yields by re-arming setTimeout. This collapses the N×4ms penalty into
+ * roughly {@code (totalWork / SLICE_MS)} ticks while still letting the
+ * browser repaint, fire input handlers, and resolve other promises between
+ * slices.</p>
+ *
+ * <p>Async-analyzer note: {@link #execute} stays purely synchronous from
+ * TeaVM's POV — no Thread.sleep, no I/O. {@code Window.setTimeout} is a
+ * leaf JS call. This avoids propagating the async tag through every
+ * {@code Executor.execute} caller.</p>
+ */
+public final class YieldingExecutorService implements ExecutorService {
+
+    private static final int SLICE_MS = 2;
+    private static final List<YieldingExecutorService> INSTANCES = new ArrayList<>();
+
+    private final Deque<Runnable> queue = new ArrayDeque<>();
+    private boolean pumpScheduled;
+
+    public YieldingExecutorService() {
+        synchronized (INSTANCES) {
+            INSTANCES.add(this);
+        }
+    }
+
+    public static boolean pumpAllOnce() {
+        List<YieldingExecutorService> list;
+        synchronized (INSTANCES) {
+            list = new ArrayList<>(INSTANCES);
+        }
+
+        boolean flag = false;
+        for (YieldingExecutorService yieldingexecutorservice : list) {
+            flag |= yieldingexecutorservice.pumpInlineSlice();
+        }
+
+        return flag;
+    }
+
+    @Override
+    public void execute(Runnable command) {
+        if (command == null) return;
+        queue.addLast(command);
+        if (!pumpScheduled) {
+            pumpScheduled = true;
+            Window.setTimeout(this::pump, 0);
+        }
+    }
+
+    private void pump() {
+        this.pumpUntil(System.currentTimeMillis() + SLICE_MS);
+    }
+
+    private boolean pumpInlineSlice() {
+        return this.pumpUntil(System.currentTimeMillis() + SLICE_MS);
+    }
+
+    private boolean pumpUntil(long deadline) {
+        boolean flag = false;
+        while (!queue.isEmpty() && System.currentTimeMillis() < deadline) {
+            Runnable r = queue.pollFirst();
+            flag = true;
+            try {
+                r.run();
+            } catch (Throwable t) {
+                System.err.println("[YieldingExecutor] task threw: " + t);
+                t.printStackTrace();
+            }
+        }
+        if (!queue.isEmpty()) {
+            Window.setTimeout(this::pump, 0);
+        } else {
+            pumpScheduled = false;
+        }
+
+        return flag;
+    }
+
+    @Override public void shutdown() {}
+    @Override public List<Runnable> shutdownNow() { return Collections.emptyList(); }
+    @Override public boolean isShutdown() { return false; }
+    @Override public boolean isTerminated() { return false; }
+    @Override public boolean awaitTermination(long timeout, TimeUnit unit) { return true; }
+    @Override public <T> Future<T> submit(Callable<T> task) {
+        FutureTask<T> f = new FutureTask<>(task);
+        execute(f);
+        return f;
+    }
+    @Override public <T> Future<T> submit(Runnable task, T result) {
+        FutureTask<T> f = new FutureTask<>(task, result);
+        execute(f);
+        return f;
+    }
+    @Override public Future<?> submit(Runnable task) {
+        FutureTask<?> f = new FutureTask<>(task, null);
+        execute(f);
+        return f;
+    }
+    @Override public <T> List<Future<T>> invokeAll(Collection<? extends Callable<T>> tasks) { throw new UnsupportedOperationException(); }
+    @Override public <T> List<Future<T>> invokeAll(Collection<? extends Callable<T>> tasks, long timeout, TimeUnit unit) { throw new UnsupportedOperationException(); }
+    @Override public <T> T invokeAny(Collection<? extends Callable<T>> tasks) { throw new UnsupportedOperationException(); }
+    @Override public <T> T invokeAny(Collection<? extends Callable<T>> tasks, long timeout, TimeUnit unit) { throw new UnsupportedOperationException(); }
+}
