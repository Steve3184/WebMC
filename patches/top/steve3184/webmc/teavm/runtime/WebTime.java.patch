--- a/top/steve3184/webmc/teavm/runtime/WebTime.java
+++ b/top/steve3184/webmc/teavm/runtime/WebTime.java
@@ -0,0 +1,40 @@
+package top.steve3184.webmc.teavm.runtime;
+
+import org.teavm.jso.JSBody;
+
+public final class WebTime {
+    private WebTime() {
+    }
+
+    public static long nanoTime() {
+        double ms = performanceNow();
+        if (Double.isNaN(ms) || Double.isInfinite(ms) || ms < 0.0) {
+            ms = dateNow();
+        }
+        if (Double.isNaN(ms) || Double.isInfinite(ms) || ms < 0.0) {
+            ms = 0.0;
+        }
+        return (long)(ms * 1_000_000.0);
+    }
+
+    public static long currentTimeMillis() {
+        double ms = dateNow();
+        if (Double.isNaN(ms) || Double.isInfinite(ms) || ms < 0.0) {
+            ms = performanceNow();
+        }
+        if (Double.isNaN(ms) || Double.isInfinite(ms) || ms < 0.0) {
+            ms = 0.0;
+        }
+        return (long)ms;
+    }
+
+    public static double seconds() {
+        return nanoTime() / 1_000_000_000.0;
+    }
+
+    @JSBody(script = "return (typeof performance !== 'undefined' && performance.now) ? performance.now() : Date.now();")
+    private static native double performanceNow();
+
+    @JSBody(script = "return Date.now();")
+    private static native double dateNow();
+}
