+++ b/top/steve3184/webmc/net/OfflineGameProfileRepository.java
@@ -0,0 +1,43 @@
+package top.steve3184.webmc.net;
+
+import com.mojang.authlib.GameProfile;
+import com.mojang.authlib.GameProfileRepository;
+import com.mojang.authlib.ProfileLookupCallback;
+import java.util.Optional;
+import net.minecraft.core.UUIDUtil;
+
+/**
+ * Offline-only profile repository used by the web runtime while Mojang auth is
+ * unavailable.
+ */
+public final class OfflineGameProfileRepository implements GameProfileRepository {
+    public static final OfflineGameProfileRepository INSTANCE = new OfflineGameProfileRepository();
+
+    private OfflineGameProfileRepository() {
+    }
+
+    @Override
+    public void findProfilesByNames(String[] names, ProfileLookupCallback callback) {
+        if (names == null || callback == null) {
+            return;
+        }
+
+        for (String name : names) {
+            Optional<GameProfile> profile = this.findProfileByName(name);
+            if (profile.isPresent()) {
+                callback.onProfileLookupSucceeded(profile.get());
+            } else {
+                callback.onProfileLookupFailed(name, new IllegalStateException("Offline profile unavailable"));
+            }
+        }
+    }
+
+    @Override
+    public Optional<GameProfile> findProfileByName(String name) {
+        if (name == null || name.isBlank()) {
+            return Optional.empty();
+        }
+
+        return Optional.of(UUIDUtil.createOfflineProfile(name));
+    }
+}
