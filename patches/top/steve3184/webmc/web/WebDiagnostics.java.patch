--- /dev/null
+++ b/top/steve3184/webmc/web/WebDiagnostics.java
@@ -0,0 +1,86 @@
+package top.steve3184.webmc.web;
+
+import org.teavm.jso.JSBody;
+
+public final class WebDiagnostics {
+    private static boolean initialized;
+    private static boolean enabled;
+    private static boolean frameProbeInitialized;
+    private static boolean frameProbeEnabled;
+
+    private WebDiagnostics() {
+    }
+
+    public static boolean enabled() {
+        if (!BuildFlags.WEB_RUNTIME) {
+            return false;
+        }
+        if (!initialized) {
+            enabled = readEnabled();
+            initialized = true;
+        }
+        return enabled;
+    }
+
+    public static void log(String message) {
+        if (enabled()) {
+            write(message);
+        }
+    }
+
+    public static void timelineEvent(String name, String phase, String detail, int value, long startMs) {
+        if (!enabled()) {
+            return;
+        }
+
+        long elapsedMsLong = startMs == 0L ? 0L : System.currentTimeMillis() - startMs;
+        int elapsedMs = (int)Math.min((long)Integer.MAX_VALUE, Math.max(0L, elapsedMsLong));
+        writeTimelineEvent(name, phase, detail, value, elapsedMs);
+    }
+
+    public static boolean frameProbeEnabled() {
+        if (!BuildFlags.WEB_RUNTIME) {
+            return false;
+        }
+        if (!frameProbeInitialized) {
+            frameProbeEnabled = readFrameProbeEnabled();
+            frameProbeInitialized = true;
+        }
+        return frameProbeEnabled;
+    }
+
+    @JSBody(script =
+        "try {" +
+        "  if (typeof window === 'undefined') return false;" +
+        "  if (window.webmcDiagnostics) return true;" +
+        "  return new URLSearchParams(window.location.search || '').get('diagnostics') === '1';" +
+        "} catch (e) { return false; }")
+    private static native boolean readEnabled();
+
+    @JSBody(script =
+        "try {" +
+        "  if (typeof window === 'undefined') return false;" +
+        "  if (window.webmcFrameProbe || window.webmcDiagnostics) return true;" +
+        "  var params = new URLSearchParams(window.location.search || '');" +
+        "  return params.get('frameprobe') === '1' || params.get('diagnostics') === '1';" +
+        "} catch (e) { return false; }")
+    private static native boolean readFrameProbeEnabled();
+
+    @JSBody(params = "message", script = "console.log(String(message));")
+    private static native void write(String message);
+
+    @JSBody(params = {"name", "phase", "detail", "value", "elapsedMs"}, script =
+        "try {" +
+        "  if (typeof window === 'undefined') return;" +
+        "  var s = window.__webmcState || (window.__webmcState = {});" +
+        "  var key = String(name || 'diagnosticEvents');" +
+        "  var events = s[key] || (s[key] = []);" +
+        "  if (events.length < 640) events.push({" +
+        "    at: Date.now(), elapsedMs: elapsedMs, phase: String(phase || '')," +
+        "    detail: String(detail || ''), value: value" +
+        "  });" +
+        "  s[key + 'At'] = Date.now();" +
+        "  s[key + 'ElapsedMs'] = elapsedMs;" +
+        "} catch (e) {}")
+    private static native void writeTimelineEvent(String name, String phase, String detail, int value, int elapsedMs);
+}
