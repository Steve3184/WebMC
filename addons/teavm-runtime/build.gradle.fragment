// Note: This fragment is a historical reference.
// TeaVM configuration is now defined directly in the root build.gradle.
// JDK stub compilation tasks are also centralized there.
// Do not apply this fragment as-is — it contains duplicate task definitions.

buildscript {
    repositories {
        mavenCentral()
        gradlePluginPortal()
    }
    dependencies { classpath 'org.teavm:teavm-gradle-plugin:0.13.1' }
}

apply plugin: 'org.teavm'

teavm {
    all {
        mainClass = 'top.steve3184.webmc.web.WebMain'
        optimization = org.teavm.gradle.api.OptimizationLevel.NONE
        debugInformation = true
        outOfProcess = true
        processMemory = 8192
        fastGlobalAnalysis = false
    }
    js {
        targetFileName = 'game.js'
        entryPointName = 'main'
        moduleType = org.teavm.gradle.api.JSModuleType.NONE
        sourceMap = false
        obfuscated = false
        strict = false
        sourceFilePolicy = org.teavm.gradle.api.SourceFilePolicy.DO_NOTHING
        addedToWebApp = false
    }
}
