{
  "scripts": {
    "clean:local": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/clean-local.ps1",
    "clean:local:whatif": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/clean-local.ps1 -WhatIf",
    "clean:local:keep-proofs": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/clean-local.ps1 -KeepProofArtifacts",
    "clean:local:keep-proofs:whatif": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/clean-local.ps1 -KeepProofArtifacts -WhatIf",
    "verify:local": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/verify-local-state.ps1",
    "verify:local:allow-reports": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/verify-local-state.ps1 -AllowReports",
    "verify:local:allow-proofs": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/verify-local-state.ps1 -AllowProofArtifacts",
    "verify:local:allow-reports-proofs": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/verify-local-state.ps1 -AllowReports -AllowProofArtifacts",
    "verify:render": "node scripts/verify-rendered-canvas.cjs",
    "verify:glsl-float-int": "node scripts/verify-glsl-float-int-scanner.cjs",
    "verify:click-smoothness": "node scripts/measure-main-menu-click-smoothness.cjs",
    "compare:click-smoothness": "node scripts/compare-main-menu-click-smoothness.cjs",
    "phase197:build": "work\\gradlew.bat -p work \"-Pwebmc.experimentalMcMain=true\" \"-Pwebmc.mcMainPhase=197\" \"-Pwebmc.teavmOutOfProcess=true\" buildWebRun --no-daemon --max-workers=1 --console=plain",
    "phase197:smoke": "work\\gradlew.bat -p work runtimeCheckMcMainPhase197 --no-daemon --max-workers=1 --console=plain",
    "phase197:soak": "work\\gradlew.bat -p work runtimeCheckMcMainPhase197Soak --no-daemon --max-workers=1 --console=plain",
    "phase197:save-reload": "work\\gradlew.bat -p work runtimeCheckMcMainPhase197SaveReload --no-daemon --max-workers=1 --console=plain",
    "phase197:rc": "work\\gradlew.bat -p work runtimeCheckMcMainPhase197Rc --no-daemon --max-workers=1 --console=plain",
    "server": "node scripts/serve-brotli.js",
    "server:prod": "node scripts/serve-brotli.js 8080",
    "compress:brotli": "brotli -f work/build/web-run/game.js -o work/build/web-run/game.js.br && brotli -f work/build/web-run/game.vfs -o work/build/web-run/game.vfs.br"
  },
  "devDependencies": {
    "playwright": "^1.61.1",
    "wabt": "^1.0.39"
  }
}
